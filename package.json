{
  "name": "target-kitchen-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype 3D kitchen visualisation platform for Target Furniture Factory (DEMO data only).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "textures:generate": "node scripts/generate-demo-textures.mjs",
    "catalogue:validate": "tsx scripts/catalogue-cli.ts validate",
    "catalogue:import": "tsx scripts/catalogue-cli.ts import",
    "catalogue:stress": "tsx scripts/catalogue-cli.ts stress"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
