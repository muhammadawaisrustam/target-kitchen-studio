# Copy to .env.local (or set these in your host's environment settings).
# Placeholders only; never commit real values. None of these are sent to the browser.

# Which catalogue JSON file(s) the app serves, relative to the project root.
# Comma-separated list allowed, e.g. data/brands/kastamonu.json,data/brands/other.json
# Leave unset to serve every file in data/brands/*.json (the real imported brands).
# If data/brands/ is empty, the app falls back to data/demo-catalogue.json.
# CATALOGUE_FILE=data/demo-catalogue.json

# Folder for data written while the app runs: quotation enquiries (when Supabase is not set)
# and products imported from the admin page. Must be on a disk that is kept between restarts.
# DATA_DIR=.data

# Admin page (/admin). Off unless set. At least 12 characters. Checked on the server only.
# ADMIN_PASSWORD=
# Optional: separate secret for signing admin sessions (defaults to one derived from ADMIN_PASSWORD).
# ADMIN_SESSION_SECRET=

# Optional: store enquiries in Supabase (free tier) instead of DATA_DIR. Needed on serverless
# hosts such as Vercel or Netlify, whose disks are not kept. Run supabase/schema.sql first.
# The service role key is secret: keep it server-side, never in a NEXT_PUBLIC_ variable.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
